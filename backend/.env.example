# ====== Servidor ======
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# ====== Banco ======
# SQLite (caminho relativo ou absoluto). Em produção aponte para um disco persistente.
DATABASE_URL=sqlite:///./data/envio.db

# ====== Porta de acesso à API (recomendado em produção) ======
# Todas as rotas /api/* exigem o cabeçalho X-Backend-Access-Key (exceto /api/status e verificar-acesso).
# Gere uma chave forte: openssl rand -hex 32
BACKEND_ACCESS_ENABLED=true
BACKEND_ACCESS_KEY=cole-aqui-chave-com-pelo-menos-32-caracteres-aleatorios

# ====== Criptografia dupla dos clientes (AES-256-GCM aplicado 2x) ======
# Campos cifrados: nome, e-mail, CPF, CNPJ, telefone, observações.
# Guarde a senha num cofre — sem ela os dados não podem ser recuperados (mín. 8 caracteres).
DATA_ENCRYPTION_ENABLED=true
# Senha mestra Terra Fértil (altere em produção; não partilhe o ficheiro .env)
DATA_ENCRYPTION_PASSWORD=@Nt1p@r1d@d3
# Opcional (senão usa backend/data/.crypto_salt gerado automaticamente):
# DATA_ENCRYPTION_SALT=

# ====== Modo SOC (resposta a incidente — painel no Dashboard) ======
# Não usa variáveis de ambiente. Na ativação: bloqueia envios/FULL e recifra clientes com
# prefixo soc2: e uma chave de emergência (diferente da DATA_ENCRYPTION_PASSWORD).
# Só POST /api/soc/desativar com essa chave restaura enc2: e libera operações.
# Guarde a chave SOC num cofre físico — não fica no servidor.

# ====== Segurança / Auth ======
# Login obrigatório (rede interna ou produção). Desative só em dev isolado: AUTH_ENABLED=false
AUTH_ENABLED=true
SECRET_KEY=troque-essa-chave-em-producao-32-bytes-minimo
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Admin criado no primeiro start (seed). Senha inicial: admin — troca obrigatória no 1.º login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Admin Diretor (conta oculta na lista de utilizadores; só ele desativa o modo SOC)
# Utilizador: admindiretor — troca obrigatória no 1.º login
DIRETOR_USERNAME=admindiretor
DIRETOR_PASSWORD=TfD1r3t0r2026
# Token de recuperação (letras+números). Se vazio, é gerado no 1.º arranque e guardado cifrado na BD.
# O diretor pode copiá-lo no Dashboard após login.
DIRETOR_RECOVERY_TOKEN=

# ====== CORS ======
# Separe por vírgula. Use * só em rede interna.
CORS_ORIGINS=*

# ====== SMTP / Brevo (envio transacional com PDF em anexo) ======
# O sistema usa SMTP (smtplib) — o mesmo que o "SMTP relay" do Brevo.
#
# NAO use a API de "campanhas" / EmailCampaigns do SDK (listas + marketing).
# Para apolices com anexo, e este relay ou a API Transactional de e-mail unico.
#
# No painel Brevo: SMTP & API -> ativar SMTP -> gere a chave SMTP (senha).
# Login (SMTP_USER): normalmente o e-mail da sua conta Brevo (ou o valor que o painel mostrar).
#
USE_BREVO=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=seu_login_brevo@empresa.com.br
# Senha SMTP do Brevo (nao confundir so com "API key v3" — pode ser outra chave no painel SMTP)
SMTP_PASSWORD=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opcional: mesmo valor em nome alternativo aceito pelo backend
# BREVO_SMTP_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BREVO_SMTP_LOGIN=seu_login_brevo@empresa.com.br
#
# Remetente precisa ser um remetente verificado no Brevo (Senders / dominio)
SMTP_FROM_EMAIL=prototipo@terrafertilseguros.com.br
SMTP_FROM_NAME=Terra Fértil Corretora de Seguros

# Se USE_BREVO=true e SMTP_HOST estiver vazio, o backend assume smtp-relay.brevo.com automaticamente.

# Assunto e template padrão
EMAIL_SUBJECT_DEFAULT=Envio de Apolice - {numero_apolice}
EMAIL_TEMPLATE_DEFAULT=templates/email_padrao.html

# ====== Modo FULL ======
FULL_ENABLED=true
FULL_WATCH_FOLDER=./entrada
FULL_SCAN_INTERVAL_SECONDS=30

# ====== Backup ======
BACKUP_FOLDER=./backup
# Retenção recomendada (meses) — pastas YYYY-MM mais antigas podem ser apagadas pela equipe
BACKUP_RETENTION_MONTHS=24

# ====== Pastas de trabalho ======
UPLOAD_FOLDER=./uploads
PROCESSED_FOLDER=./processados

# ====== Capa (PDF antes da apólice) ======
# Coloque capa.pdf em CAPA_FOLDER (relativo à pasta backend/). Se o ficheiro existir,
# cada envio junta: [capa] + [PDF original] num só PDF para backup e e-mail.
CAPA_ENABLED=true
CAPA_FOLDER=./capas
CAPA_ARQUIVO_PADRAO=capa.pdf

# ====== OCR (PDFs só imagem) ======
# Requer Tesseract instalado (Windows: https://github.com/UB-Mannheim/tesseract/wiki)
OCR_ENABLED=true
OCR_MAX_PAGES=5
OCR_LANG=por
# Caminho completo do tesseract.exe se não estiver no PATH (ex.: C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
